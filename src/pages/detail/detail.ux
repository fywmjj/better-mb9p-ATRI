<template>
  <div class="container">
    <image class="bg" src="{{ bg_image }}"></image>
    <image class="character" src="{{ fg_image }}"></image>
    <div class="title-wrapper" show="{{ title_visible }}">
      <text class="title">{{ title }}</text>
    </div>
    <div class="text-wrapper" show="{{ text_visible }}">
      <text class="name" show="{{ name_visible }}">{{ name }}</text>
      <text class="text">{{ text }}</text>
    </div>
    <div class="choice-wrapper" show="{{ choice_visible }}">
      <div class="choice-item" for="{{ choices }}" onclick="onChoice({{ $idx }})">
        <text class="choice-text">{{ $item }}</text>
      </div>
    </div>
    <image class="back-button" src="/common/gui/backButton.png" onclick="goBack"></image>
  </div>
</template>

<style>
  .container {
    width: 100%;
    height: 100%;
    background-color: #000000;
  }

  .bg {
    width: 100%;
    height: 100%;
    left: 0px;
    top: 0px;
  }

  .character {
    width: 100%;
    height: 100%;
    left: 0px;
    top: 0px;
  }

  .title-wrapper {
    width: 100%;
    height: 100%;
    left: 0px;
    top: 0px;
    justify-content: center;
    align-items: center;
  }

  .title {
    font-size: 48px;
    color: #ffffff;
  }

  .text-wrapper {
    left: 10%;
    top: 55%;
    width: 80%;
    height: 40%;
    background-color: rgba(0, 0, 0, 0.5);
    flex-direction: column;
    padding: 20px;
  }

  .name {
    font-size: 32px;
    color: #ffffff;
  }

  .text {
    font-size: 28px;
    color: #ffffff;
    margin-top: 10px;
  }

  .choice-wrapper {
    width: 100%;
    height: 100%;
    left: 0px;
    top: 0px;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }

  .choice-item {
    width: 80%;
    height: 100px;
    background-color: rgba(0, 0, 0, 0.8);
    margin-top: 20px;
    justify-content: center;
    align-items: center;
  }

  .choice-text {
    font-size: 32px;
    color: #ffffff;
  }

  .back-button {
    width: 64px;
    height: 64px;
    left: 10px;
    top: 10px;
  }
</style>

<script>
  import router from '@system.router'
  import file from '@system.file'

  export default {
    private: {
      lines: [],
      line_index: 0,
      bg_image: '/common/images/bg.png',
      fg_image: '/common/images/none.png',
      title: '',
      title_visible: false,
      name: '',
      name_visible: false,
      text: '',
      text_visible: false,
      choices: [],
      choice_visible: false,
      choice_callbacks: [],
    },
    onInit() {
      this.continueDialog = this.continueDialog.bind(this)
      this.update = this.update.bind(this)
      this.onChoice = this.onChoice.bind(this)
      this.goBack = this.goBack.bind(this)
      this.load(this.uri)
    },
    // 这个函数负责更新所有界面元素的状态，每次都得手动调，有点麻烦，下个版本看看能不能优化下。
    update() {
      this.bg_image = this.bg_image
      this.fg_image = this.fg_image
      this.title = this.title
      this.title_visible = this.title_visible
      this.name = this.name
      this.name_visible = this.name_visible
      this.text = this.text
      this.text_visible = this.text_visible
      this.choices = this.choices
      this.choice_visible = this.choice_visible
    },
    load(uri) {
      file.readText({
        uri: uri,
        success: (data) => {
          this.lines = data.text.split('\n')
          this.line_index = 0
          this.continueDialog()
        },
        fail: (data, code) => {
          this.text = `Error: ${code}`
          this.text_visible = true
          this.update()
        },
      })
    },
    continueDialog() {
      // HACK: 这里之前有个死循环的bug，如果剧情文件里有空行就会卡死，找了好半天...现在修好了。
      while (true) {
        if (this.line_index >= this.lines.length) {
          return
        }
        let line = this.lines[this.line_index]
        if (line.startsWith('[name]')) {
          this.name = line.substring(6)
          this.name_visible = true
        } else if (line.startsWith('[title]')) {
          this.title = line.substring(7)
          this.title_visible = true
        } else if (line.startsWith('[image]')) {
          this.fg_image = `/common/character/${line.substring(7)}`
        } else if (line.startsWith('[bg]')) {
          this.bg_image = `/common/images/${line.substring(4)}`
        } else if (line.startsWith('[choice]')) {
          const parts = line.substring(8).split(',')
          this.choices.push(parts[0])
          this.choice_callbacks.push(parts[1])
        } else if (line.startsWith('[jump]')) {
          this.load(`internal://common/content/${line.substring(6)}`)
          return
        } else if (line.startsWith('[endchoice]')) {
          this.choice_visible = true
          this.update()
          return
        } else if (line.startsWith('[end]')) {
          this.goBack()
          return
        } else if (line.trim().length > 0) {
          // 对白文本的处理逻辑
          this.text = line
          this.text_visible = true
          this.line_index++
          this.update()
          return
        }
        // 关键修复！确保每次循环都会前进到下一行，避免死循环
        this.line_index++
      }
    },
    onChoice(index) {
      const uri = this.choice_callbacks[index]
      this.choice_visible = false
      this.choices = []
      this.choice_callbacks = []
      this.load(`internal://common/content/${uri}`)
    },
    goBack() {
      router.back()
    },
  }
</script>